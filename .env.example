# Environment Variables Template for Temple Management System (TMS)

# Database: SQLite locally, or PostgreSQL in staging/production
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/temple_db?schema=public"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secret for Session Cookies
JWT_SECRET="replace_with_a_secure_random_64_character_string"

# Razorpay Credentials (Indian Payment Gateway)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# Development Payment Sandbox Simulation (true/false)
NEXT_PUBLIC_ENABLE_PAYMENT_SIMULATOR="true"

# Temple Branding
NEXT_PUBLIC_TEMPLE_NAME="Shri Ram Janmabhoomi & Mahadev Mandir"
NEXT_PUBLIC_TEMPLE_LOCATION="Ayodhya Dham, Uttar Pradesh, India"
NEXT_PUBLIC_TEMPLE_PHONE="+91 5278 297 108"
NEXT_PUBLIC_TEMPLE_EMAIL="sevadar@shrirammandirtrust.org"

# 80G Tax Exemption (Set to true only if temple trust holds valid 80G order)
NEXT_PUBLIC_80G_ENABLED="true"
NEXT_PUBLIC_80G_REG_NUMBER="CIT(E)/AYODHYA/80G/2024/AABTS1234F"
